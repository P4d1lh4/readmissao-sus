# Ambiente
.venv/
.env
__pycache__/
*.pyc
.pytest_cache/

# Dados do SIH/SUS nunca vão para o git
data/*
!data/.gitkeep
*.dbc
*.dbf
*.parquet
*.duckdb
*.duckdb.wal

# Artefatos
models/
# reports/: só agregados vão para o git (S10); nada por episódio
reports/*
!reports/metrics.json
!reports/importancia_atributos.csv
artifacts/
build/
dist/
*.egg-info/

# Pacotes FHIR (scripts/baixar_pacotes_fhir.py). Só o da SES-GO vai para o git:
# a URL de homologação não tem versão e pode mudar (ver D02 em docs/decisoes.md).
fhir/pacotes/*.tgz
!fhir/pacotes/br.go.ses.core-1.2.6.tgz
fhir/pacotes/*.part

# Validador HL7 (validator_cli.jar) e saídas temporárias de scripts/validar_fhir.py
.cache/

# Sumários de Alta gerados de episódios reais do SIH (scripts/gerar_sumarios.py): fora do git
fhir/saida/
